<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        窗口底色：**首帧之前的**那层背景。

        它必须与 `CarColors.background` 一一对应，否则冷启动会看到一次闪色：
        Compose 的第一帧画出来之前，屏幕上就是这个颜色。

        这里用 day/night 资源对而不是单一颜色，因为 Compose 侧的
        `isSystemInDarkTheme()` 和资源的 `-night` 限定符**读的是同一个
        uiMode 开关**，两者天然同步，不会出现"窗口是深色、页面是浅色"。
    -->
    <color name="car_window_background">#F7F8FA</color>
</resources>
